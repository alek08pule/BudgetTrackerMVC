@using BudgetTrackerMVC.ViewModels

@model LoginVM

@{
    ViewData["Title"] = "Login";
}
<div class="loginForm" id="login">
    <form class="form" asp-controller="User" asp-action="Login" method="post">
        @Html.AntiForgeryToken()
        
        <div asp-validation-summary="ModelOnly"></div>
        <div class="form_inputs-group">
            <input asp-for="Email" id="loginEmail" class="form_input" type="text" placeholder="Email address"  />
            <span asp-validation-for="Email" class="form_input-error-messagetext-danger"></span>
        </div>
        <div class="form_inputs-group">
            <div class="inputPass">
                <input asp-for="Password" id="loginPassword" class="form_input" type="password" placeholder="Enter password" />
                <span asp-for="simbol" id="togglePassword" class="eye-icon"></span>
            </div>
                      <span asp-validation-for="Password" class="text-danger"></span>
            
        </div>
       

        <button class="form_button" type="submit" id="goToHomePage">Sign In</button>
        <p class="form_text">
        Don't have an account?
            <a  asp-action="Register" class="form_link" id="linkCreateAccount"> Create account.</a>
        </p>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

<script>
        document.getElementById("togglePassword").addEventListener("click", function () {
            const passwordField = document.getElementById("loginPassword");
            const type = passwordField.type === "password" ? "text" : "password";
            passwordField.type = type;
        });
</script>
}